# foundation.fml — version routing (Modelling Guide §6)

"FC Actual IN" { Versions, YearMonth }
  @type integer
  @folder "Foundation"
  @notes "1 = this period of this version takes actuals; empty = plan. Writer: model administrator."

"FC Actual Flag" { Versions, YearMonth } = "FC Actual IN"
  @type integer
  @rollup average
  @folder "Foundation"
  @notes "Routing flag read by every merged output and by the price reset."
  @readonly true
